# --- Generated / heavy artifacts: never commit these ---
# Marked images, phone captures, checkpoints, plots are all reproducible
# from code + seeds (except captures, which live OUTSIDE the repo).
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep
runs/
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.webp
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

